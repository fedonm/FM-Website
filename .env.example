# ==============================================================================
# FEDON MESTHANEFS - PRODUCTION ENVIRONMENT VARIABLES
# ==============================================================================

# Server & Runtime Configuration
NODE_ENV=production
PORT=3000

# Production Hostname Validation (Optional, e.g. fedonmesthanefs.com)
PRODUCTION_HOSTNAME=fedonmesthanefs.com

# Target Email for Booking Inquiries
NOTIFICATION_EMAIL=mesthanefs@gmail.com

# ------------------------------------------------------------------------------
# Cloudflare Turnstile Configuration
# ------------------------------------------------------------------------------
# Frontend Public Sitekey (Managed Mode) - Exposed to Vite Client
VITE_TURNSTILE_SITE_KEY=0x4AAAAAAAxxxxxxxxxxxxxx

# Backend Secret Key - NEVER EXPOSED TO CLIENT BUNDLES OR FRONTEND
CLOUDFLARE_TURNSTILE_SECRET_KEY=0x4AAAAAAAxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ------------------------------------------------------------------------------
# SMTP Email Delivery Configuration (e.g. Resend, SendGrid, Brevo, or Custom SMTP)
# ------------------------------------------------------------------------------
SMTP_HOST=smtp.resend.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=resend
SMTP_PASS=re_xxxxxxxxxxxxxxxxxxxxxxxx
SMTP_FROM="Φαίδων Μεσθανεύς" <no-reply@fedonmesthanefs.com>

# ------------------------------------------------------------------------------
# Optional AI Studio Runtime Variables
# ------------------------------------------------------------------------------
GEMINI_API_KEY=
APP_URL=
